---
import CommonHead from "@/components/common-head.astro";
import CommonBody from "@/components/common-body.astro";
import EdgeCryptoPage from "@/components/edge-crypto-page.tsx";
import Navbar from "@/components/navbar";
import { initI18n, extractNavbarTranslations, supportedLanguages } from "@/i18n";
import "@/styles/global.css";

export function getStaticPaths() {
  return supportedLanguages.map((lang) => ({ params: { lang } }));
}

const { language, t } = initI18n(Astro);
const navbarTranslations = extractNavbarTranslations(t);

const pageTitle = t("sideProjects.edgeCrypto.pageTitle", {
  defaultValue:
    language === "ko"
      ? "Edge Crypto - Universal SubtleCrypto toolkit"
      : "Edge Crypto - Universal SubtleCrypto Toolkit",
});
const pageDescription = t("sideProjects.edgeCrypto.pageDescription", {
  defaultValue:
    "Encrypt, sign, hash, and manage RSA keys across Node.js, browsers, Cloudflare Workers, Deno, and Bun.",
});
const lang = language;
const ogImage = new URL(`/${lang}/edge-crypto/og.png`, Astro.url).toString();

// Check if nonav query parameter is present
const hideNavbar = Astro.url.searchParams.has("nonav");
---

<html lang={language}>
  <head>
    <CommonHead title={pageTitle} description={pageDescription} lang={language} ogImage={ogImage} />
    <script is:inline>
      // Force dark theme
      (function () {
        document.documentElement.classList.add("dark");
        localStorage.setItem("theme", "dark");
      })();
    </script>
  </head>
  <body class="bg-black overflow-x-hidden">
    <CommonBody lang={language} />
    <div class="max-w-[1500px] mx-auto w-full">
      <EdgeCryptoPage client:only="react" lang={lang} />
    </div>
    {
      !hideNavbar && (
        <Navbar client:only="preact" lang={language} translations={navbarTranslations} />
      )
    }
  </body>
</html>
